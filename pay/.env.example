# Live mainnet. Production: Helius/Triton keyed URL. Public RPC is fallback only.
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Product default is LIVE matching + burn. Set 1 only for local tests.
DRY_RUN=0

POLL_MS=2000

# Fee payer is data/feepayer.key (JSON secret array, gitignored, mode 0600).
# Wrap key is data/.wrapkey (auto-created, mode 0600). Never put secrets here.
