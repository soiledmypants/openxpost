# Public (client). Same names without VITE_ work on the server.
# Changing Netlify env + the default constants in pay/types.ts updates
# the quiet CA slot, payment mint / amountRaw, and the copyable Pay address.
# VITE_TOKEN_MINT=CniGxmdBgiPivEYyY3eLJYTLsU3agGXVY6T23wncpump
# VITE_TOKEN_AMOUNT=100000
# VITE_TREASURY_ADDRESS=NBQhuKpHq4M6wmGmgAhZKt4yCJ1JqxY7h8Cf3SM2mMQ
# VITE_SOLANA_RPC=

# Server only — never prefix with VITE_. Do not commit values.
# HELIUS_API_KEY=
# HELIUS_RPC_URL=
# TOKEN_MINT=
# TOKEN_AMOUNT=
# TREASURY_ADDRESS=
# SOLANA_RPC=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_ACCESS_TOKEN=
# X_REFRESH_TOKEN=
